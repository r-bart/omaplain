{
  "schemaVersion": 1,
  "id": "io.github.r-bart.omaplain",
  "name": "OmaPlain",
  "version": "0.2.0",
  "author": "OmaPlain contributors",
  "license": "GPL-3.0-or-later",
  "description": "Paste clean text by default while preserving files, images and secrets.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaPlain",
    "description": "Opens the OmaPlain clipboard panel",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
