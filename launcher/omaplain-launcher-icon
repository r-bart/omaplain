#!/usr/bin/env bash
# Repinta el icono del lanzador con los colores del tema de Omarchy.
#
# Se instala como hook de `theme-set` —el gancho que Omarchy ya llama al
# final de `omarchy-theme-set`—, así que corre solo cada vez que cambias de
# tema. Sin instalarlo, el lanzador enseña el icono de marca de siempre.
#
# **Escribe la ruta, no el contenido.** Reescribir el SVG en su sitio no
# sirve: el shell es un proceso largo y Qt cachea el pixmap por la URL del
# fichero, así que el icono nuevo no se ve hasta que el shell reinicia.
# Cambiando el `Icon=` de la entrada, la URL es otra, la caché no acierta y
# el lanzador se actualiza al momento. Las dos cosas están medidas en la
# [`0020`](../docs/decisions/0020-la-marca-se-dibuja.md).
#
# No inventa geometría: lee `mark.svg`, que está aquí al lado, y le cambia
# los dos colores. El dibujo sigue viviendo en un solo sitio — un test compara
# su trazo con el del icono de marca y con el de `components/Mark.qml`.
set -uo pipefail

# Cualquier motivo para no hacer nada sale con 0: `omarchy-hook` avisa por
# consola de todo hook que falle, y «no está instalado el lanzador» no es
# un fallo.
propio=$(readlink -f "${BASH_SOURCE[0]}" 2> /dev/null) || exit 0
plantilla=$(dirname "$propio")/mark.svg

datos="${XDG_DATA_HOME:-$HOME/.local/share}"
entrada="$datos/applications/io.github.r-bart.omaplain.desktop"
destino="$datos/omaplain/icons"

[ -f "$entrada" ] || exit 0
[ -f "$plantilla" ] || exit 0
command -v omarchy-theme-color > /dev/null 2>&1 || exit 0

# El reparto. El trazo va en el primer plano del tema —el negativo de
# aquello sobre lo que se pinta— y el punto en su acento. Nada de baldosa:
# sin fondo, el icono contrasta en un tema claro por el mismo motivo que en
# uno oscuro, y no hay que elegir un color de relleno que valga para los dos.
tinta=$(omarchy-theme-color foreground 2> /dev/null)
punto=$(omarchy-theme-color accent 2> /dev/null)

for color in "$tinta" "$punto"; do
  [[ $color =~ ^#[0-9A-Fa-f]{6}$ ]] || exit 0
done

# El nombre lleva la huella de los colores. Dos temas distintos son dos
# ficheros distintos, y volver a un tema ya visto no repinta nada.
sello=$(printf '%s' "$tinta|$punto" | sha256sum | cut -c1-12)
icono="$destino/omaplain-$sello.svg"

puesto=$(sed -n 's/^Icon=//p' "$entrada" | head -1)
[ "$puesto" = "$icono" ] && [ -f "$icono" ] && exit 0

mkdir -p "$destino" || exit 0
temporal=$(mktemp "$destino/.omaplain-XXXXXX") || exit 0
if ! sed -e "s/#1B201E/$tinta/" -e "s/#3E8E79/$punto/" \
     "$plantilla" > "$temporal"; then
  rm -f "$temporal"
  exit 0
fi
mv -f "$temporal" "$icono" || { rm -f "$temporal"; exit 0; }

# La entrada apunta al fichero nuevo. Es la única línea que se toca de un
# fichero que es del usuario.
sed -i "s|^Icon=.*|Icon=$icono|" "$entrada"

# Y se barren los que dejó el tema anterior: son nuestros y no valen ya.
find "$destino" -maxdepth 1 -name 'omaplain-*.svg' ! -name "omaplain-$sello.svg" \
  -delete 2> /dev/null

command -v update-desktop-database > /dev/null 2>&1 &&
  update-desktop-database "$(dirname "$entrada")" 2> /dev/null

exit 0
